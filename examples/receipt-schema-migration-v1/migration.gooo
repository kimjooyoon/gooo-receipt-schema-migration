metric id=adapter_operations activity=execute_generated_adapters source=examples/receipt-schema-migration-v1/migration.gooo ir=adapters[*].operations artifact=generated/validator.json evaluator=ValidateVersionedReceipt
metric id=artifact_digests activity=bind_artifact_digests source=examples/receipt-schema-migration-v1/migration.gooo ir=artifacts[*].digest artifact=artifact-manifest.json evaluator=ValidateArtifactManifest
metric id=build_wall_ms activity=measure_ci_build source=examples/receipt-schema-migration-v1/migration.gooo ir=ci.metrics.build_wall_ms artifact=ci-summary.json evaluator=ValidateCISummary
