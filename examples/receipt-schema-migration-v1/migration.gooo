gooo receipt_schema_migration v1

denominator id=receipt-schema-migration-v1 cell_count=12
axis stage FOUNDATION=4,COHERENCE=4,REGRESSION=4
axis role DRIVER=4,OUTCOME=4,GUARDRAIL=4
authority repository_writes=0 local_test_executions=0 cross_project_required_gates=0 product_generation_authorized=false root_readme_policy=EXCLUDED_FROM_REPOSITORY_INVENTORY
precedence REFUTED>UNKNOWN>CLOSED
unknown_fields stage,step,reason,unknown_class,next_operation,blocked_by

schema version=v2 owner=parent input_schema=gooo/receipt/parent/v2 output_schema=gooo/receipt/internal/parent/v1 operations=ADAPT_V2_IMMUTABLE_PARENT,READ_PARENT_DIGEST,REJECT_FUTURE_FIELDS owned_fields=schema,schema_version,receipt_id,kind,denominator_id,denominator_cell_count,denominator_stage_counts,denominator_role_counts,immutable,created_by,digest forbidden_fields=outcome,parent_outcome,cause_code,causal_chain,next_operation,attestation
schema version=v3 owner=child input_schema=gooo/receipt/child/v3 output_schema=gooo/receipt/internal/child/v1 operations=ADAPT_V3_OUTCOME_CHILD,READ_PARENT_LINEAGE,VALIDATE_CAUSAL_FIELDS owned_fields=schema,schema_version,receipt_id,parent_receipt_id,parent_digest,parent_outcome,outcome,cause_code,causal_chain,next_operation,denominator_id,denominator_cell_count,denominator_stage_counts,denominator_role_counts,attestation,child_ordinal,digest forbidden_fields=rewrite_parent

cell ordinal=1 id=NORMAL_V2_PARENT_V3_CHILD stage=FOUNDATION role=DRIVER edge=v2-parent:immutable->v3-child:outcome depends_on=-
cell ordinal=2 id=NORMAL_REPLAY_DETERMINISTIC stage=FOUNDATION role=OUTCOME edge=receipt:bytes->replay:bytes depends_on=NORMAL_V2_PARENT_V3_CHILD
cell ordinal=3 id=UNKNOWN_PARENT_DIGEST_MISSING stage=FOUNDATION role=GUARDRAIL edge=parent:digest-missing->unknown depends_on=NORMAL_REPLAY_DETERMINISTIC
cell ordinal=4 id=UNKNOWN_CHILD_DIGEST_STALE stage=COHERENCE role=OUTCOME edge=child:digest-stale->unknown depends_on=UNKNOWN_PARENT_DIGEST_MISSING
cell ordinal=5 id=UNKNOWN_UNSUPPORTED_FUTURE_SCHEMA stage=FOUNDATION role=DRIVER edge=child:schema-future->unknown depends_on=UNKNOWN_PARENT_DIGEST_MISSING
cell ordinal=6 id=REFUTED_CHILD_REWRITES_PARENT stage=COHERENCE role=DRIVER edge=child:write-parent->refuted depends_on=UNKNOWN_CHILD_DIGEST_STALE
cell ordinal=7 id=REFUTED_FUTURE_FIELD_IN_OLD_SCHEMA stage=COHERENCE role=GUARDRAIL edge=v2-parent:future-field->refuted depends_on=REFUTED_CHILD_REWRITES_PARENT
cell ordinal=8 id=REFUTED_PARENT_DIGEST_MISMATCH stage=COHERENCE role=OUTCOME edge=child:parent-digest-mismatch->refuted depends_on=REFUTED_FUTURE_FIELD_IN_OLD_SCHEMA
cell ordinal=9 id=REFUTED_SECOND_CHILD_CARDINALITY_ONE stage=REGRESSION role=DRIVER edge=parent:one-child->child:two->refuted depends_on=REFUTED_PARENT_DIGEST_MISMATCH
cell ordinal=10 id=REFUTED_SELF_ATTESTATION stage=REGRESSION role=GUARDRAIL edge=child:attestation-self->refuted depends_on=REFUTED_SECOND_CHILD_CARDINALITY_ONE
cell ordinal=11 id=REFUTED_DENOMINATOR_DOWNGRADE stage=REGRESSION role=GUARDRAIL edge=denominator:12->11->refuted depends_on=REFUTED_SELF_ATTESTATION
cell ordinal=12 id=REFUTED_UNKNOWN_PROMOTED_FIXED_POINT stage=REGRESSION role=OUTCOME edge=unknown->fixed-point->refuted depends_on=REFUTED_DENOMINATOR_DOWNGRADE

scenario ordinal=1 id=NORMAL_V2_PARENT_V3_CHILD cell=NORMAL_V2_PARENT_V3_CHILD class=NORMAL expected=ACCEPTED parent_mode=V2 child_mode=V3 operation=accept_append_only_child
scenario ordinal=2 id=NORMAL_REPLAY_DETERMINISTIC cell=NORMAL_REPLAY_DETERMINISTIC class=NORMAL expected=ACCEPTED parent_mode=V2 child_mode=V3_REPLAY operation=accept_identical_replay
scenario ordinal=3 id=UNKNOWN_PARENT_DIGEST_MISSING cell=UNKNOWN_PARENT_DIGEST_MISSING class=UNKNOWN expected=UNKNOWN parent_mode=V2 child_mode=V3_PARENT_DIGEST_MISSING operation=preserve_unknown_parent_lineage
scenario ordinal=4 id=UNKNOWN_CHILD_DIGEST_STALE cell=UNKNOWN_CHILD_DIGEST_STALE class=UNKNOWN expected=UNKNOWN parent_mode=V2 child_mode=V3_CHILD_DIGEST_STALE operation=preserve_unknown_child_integrity
scenario ordinal=5 id=UNKNOWN_UNSUPPORTED_FUTURE_SCHEMA cell=UNKNOWN_UNSUPPORTED_FUTURE_SCHEMA class=UNKNOWN expected=UNKNOWN parent_mode=V2 child_mode=V4_FUTURE operation=preserve_unknown_future_schema
scenario ordinal=6 id=REFUTED_CHILD_REWRITES_PARENT cell=REFUTED_CHILD_REWRITES_PARENT class=REFUTED expected=REFUTED parent_mode=V2 child_mode=V3_REWRITE_PARENT operation=reject_parent_rewrite
scenario ordinal=7 id=REFUTED_FUTURE_FIELD_IN_OLD_SCHEMA cell=REFUTED_FUTURE_FIELD_IN_OLD_SCHEMA class=REFUTED expected=REFUTED parent_mode=V2_FUTURE_FIELD child_mode=V3 operation=reject_future_field_in_v2
scenario ordinal=8 id=REFUTED_PARENT_DIGEST_MISMATCH cell=REFUTED_PARENT_DIGEST_MISMATCH class=REFUTED expected=REFUTED parent_mode=V2 child_mode=V3_PARENT_DIGEST_MISMATCH operation=reject_parent_digest_mismatch
scenario ordinal=9 id=REFUTED_SECOND_CHILD_CARDINALITY_ONE cell=REFUTED_SECOND_CHILD_CARDINALITY_ONE class=REFUTED expected=REFUTED parent_mode=V2 child_mode=V3_SECOND_CHILD operation=reject_second_child
scenario ordinal=10 id=REFUTED_SELF_ATTESTATION cell=REFUTED_SELF_ATTESTATION class=REFUTED expected=REFUTED parent_mode=V2 child_mode=V3_SELF_ATTESTED operation=reject_self_attestation
scenario ordinal=11 id=REFUTED_DENOMINATOR_DOWNGRADE cell=REFUTED_DENOMINATOR_DOWNGRADE class=REFUTED expected=REFUTED parent_mode=V2 child_mode=V3_DENOMINATOR_DOWNGRADE operation=reject_denominator_downgrade
scenario ordinal=12 id=REFUTED_UNKNOWN_PROMOTED_FIXED_POINT cell=REFUTED_UNKNOWN_PROMOTED_FIXED_POINT class=REFUTED expected=REFUTED parent_mode=V2 child_mode=V3_UNKNOWN_FIXED_POINT operation=reject_unknown_fixed_point

metric id=schema_versions activity=adapt_versioned_receipts source=examples/receipt-schema-migration-v1/migration.gooo ir=schemas=2 artifact=generated/adapters/v2.json,generated/adapters/v3.json evaluator=ValidateVersionedReceipt
metric id=parent_receipt_count activity=count_immutable_parents source=examples/receipt-schema-migration-v1/migration.gooo ir=scenarios[*].parent artifact=scenario-receipts.json evaluator=EvaluateScenarioBundle
metric id=child_receipt_count activity=count_append_only_children source=examples/receipt-schema-migration-v1/migration.gooo ir=scenarios[*].children artifact=scenario-receipts.json evaluator=EvaluateScenarioBundle
metric id=accepted_count activity=classify_accepted_receipts source=examples/receipt-schema-migration-v1/migration.gooo ir=scenarios[*].result.state artifact=human-report.md evaluator=EvaluateScenarioBundle
